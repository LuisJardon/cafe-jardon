# Cabeceras para Cloudflare Pages (GitHub Pages lo ignora).
# Los archivos de /_astro llevan una huella en el nombre: si cambian, cambia el nombre. Se pueden guardar un año.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/media/*
  Cache-Control: public, max-age=604800

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
