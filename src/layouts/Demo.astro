---
// Base común de todas las demos: <head>, metadatos y el botón para quitar/recuperar animaciones.
interface Props {
  title: string;
  description: string;
  themeColor?: string;
}
const { title, description, themeColor = "#111" } = Astro.props;
// Ruta base de la web (raíz de un dominio o subcarpeta, según astro.config.mjs).
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + "/";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    <link rel="preconnect" href="https://images.unsplash.com" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
    <script is:inline>
      // Estas demos existen para enseñar animación: se ven SIEMPRE con animaciones.
      // Quien tenga "reducir movimiento" en su sistema ve un botón para quitarlas (y se recuerda su elección).
      (function () {
        var sys = matchMedia("(prefers-reduced-motion: reduce)").matches, quitar = false;
        try { quitar = localStorage.getItem("demo-motion") === "off"; } catch (e) {}
        if (sys) document.documentElement.classList.add("sys-reduce");
        if (quitar) document.documentElement.classList.add("reduce");
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <slot />
    <!-- Solo aparece si el sistema pide reducir movimiento: botón para quitar o recuperar las animaciones. -->
    <div class="demo-bar" data-demo-bar hidden>
      <button class="demo-badge demo-motion" type="button" data-motion-toggle></button>
    </div>
    <script is:inline>
      (function () {
        var root = document.documentElement, btn = document.querySelector("[data-motion-toggle]");
        if (!root.classList.contains("sys-reduce") && !root.classList.contains("reduce")) return;
        document.querySelector("[data-demo-bar]").hidden = false;
        btn.textContent = root.classList.contains("reduce") ? "Activar animaciones" : "Reducir animaciones";
        btn.addEventListener("click", function () {
          try { localStorage.setItem("demo-motion", root.classList.contains("reduce") ? "on" : "off"); } catch (e) {}
          location.reload();
        });
      })();
    </script>
    <style is:global>
      .demo-bar { position: fixed; left: 16px; bottom: 16px; z-index: 90; display: flex; gap: 8px; flex-wrap: wrap; }
      .demo-motion { cursor: pointer; }
      .demo-bar[hidden] { display: none; }
      .demo-badge {
        padding: 0.55em 0.95em;
        border-radius: 999px;
        font: 500 12px/1 system-ui, sans-serif;
        letter-spacing: 0.02em;
        color: #f4f4f2;
        background: rgb(20 20 20 / 0.72);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1px solid rgb(255 255 255 / 0.14);
        text-decoration: none;
        transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .demo-badge:hover { transform: translateY(-2px); }
      .demo-badge:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
      /* En móvil no flota: va al final de la página para no tapar nada. */
      @media (max-width: 860px) {
        .demo-bar { position: static; justify-content: center; padding: 8px 16px 28px; background: var(--demo-bar-bg, transparent); }
      }
    </style>
  </body>
</html>
